// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  industry    String?
  companySize String?
  status      OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  teams           Team[]
  teamInvitations TeamInvitation[]

  @@map("organizations")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ENGINEER
}

model User {
  id String @id @default(uuid()) @db.Uuid

  organizationId String   @db.Uuid
  role           UserRole @default(ENGINEER)

  fullName     String
  email        String @unique
  passwordHash String

  designation String?
  department  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdTeams       Team[]           @relation("CreatedTeams")
  teamMemberships    TeamMember[]
  createdInvitations TeamInvitation[] @relation("CreatedInvitations")

  @@index([organizationId])
  @@map("users")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

model Team {
  id String @id @default(cuid())

  organizationId String @db.Uuid
  createdBy      String @db.Uuid

  name        String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("CreatedTeams", fields: [createdBy], references: [id])

  members     TeamMember[]
  invitations TeamInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([createdBy])
  @@map("teams")
}

model TeamMember {
  id String @id @default(cuid())

  teamId String
  userId String @db.Uuid

  role TeamRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id String @id @default(cuid())

  organizationId String @db.Uuid
  teamId         String

  invitedEmail String

  role TeamRole @default(MEMBER)

  token String @unique

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdBy String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator      User         @relation("CreatedInvitations", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([teamId])
  @@index([invitedEmail])
  @@map("team_invitations")
}

enum TeamRole {
  LEAD
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}
