// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// npx prisma studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  industry    String?
  companySize String?
  website     String?
  description String?
  phone       String?
  country     String?
  state       String?
  city        String?
  address     String?
  status      OrganizationStatus @default(PENDING_PROFILE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  teams           Team[]
  teamInvitations TeamInvitation[]

  incidents     Incident[]
  verifications OrganizationVerification[]

  monitoringProjects MonitoringProject[]
  integrations       Integration[]
  alertRoutingRules  AlertRoutingRule[]
  auditLogs          AuditLog[]

  subscription Subscription?
  payments     Payment[]

  @@map("organizations")
}

model OrganizationVerification {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  reviewedBy     String? @db.Uuid

  status          OrganizationVerificationStatus
  rejectionReason String?

  submittedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reviewer User? @relation("OrganizationVerificationReviewer", fields: [reviewedBy], references: [id])

  @@index([organizationId])
  @@index([reviewedBy])
  @@index([status])
  @@map("organization_verifications")
}

enum OrganizationVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ENGINEER
}

model User {
  id String @id @default(uuid()) @db.Uuid

  organizationId String?  @db.Uuid
  role           UserRole @default(ENGINEER)

  fullName     String
  email        String @unique
  passwordHash String

  designation String?
  department  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                    Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationVerificationReviews OrganizationVerification[] @relation("OrganizationVerificationReviewer")

  createdTeams       Team[]           @relation("CreatedTeams")
  teamMemberships    TeamMember[]
  createdInvitations TeamInvitation[] @relation("CreatedInvitations")

  createdIncidents Incident[] @relation("IncidentCreator")

  assignedTasks Task[] @relation("UserAssignedTasks")

  createdMonitoringProjects MonitoringProject[]
  createdAlertRoutingRules  AlertRoutingRule[]   @relation("CreatedAlertRoutingRules")
  createdWarRooms           WarRoom[]            @relation("WarRoomCreator")
  warRoomParticipants       WarRoomParticipant[]
  warRoomMessages           WarRoomMessage[]
  timelineEvents            TimelineEvent[]      @relation("TimelineEventActor")
  auditLogs                 AuditLog[]           @relation("AuditLogActor")
  notifications             Notification[]

  @@index([organizationId])
  @@map("users")
}

enum OrganizationStatus {
  PENDING_PROFILE
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

model Team {
  id String @id @default(cuid())

  organizationId String @db.Uuid
  createdBy      String @db.Uuid

  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("CreatedTeams", fields: [createdBy], references: [id])

  members     TeamMember[]
  invitations TeamInvitation[]

  incidents         Incident[]
  alertRoutingRules AlertRoutingRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([createdBy])
  @@map("teams")
}

model TeamMember {
  id String @id @default(cuid())

  teamId String
  userId String @db.Uuid

  role TeamRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id String @id @default(cuid())

  organizationId String @db.Uuid
  teamId         String

  invitedEmail String

  role TeamRole @default(MEMBER)

  token String @unique

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdBy String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator      User         @relation("CreatedInvitations", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([teamId])
  @@index([invitedEmail])
  @@map("team_invitations")
}

enum TeamRole {
  LEAD
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model Incident {
  id          String  @id @default(cuid())
  title       String
  description String?

  severity IncidentSeverity
  priority IncidentPriority
  status   IncidentStatus
  type     IncidentType

  organizationId      String  @db.Uuid
  createdBy           String? @db.Uuid
  assignedTeamId      String?
  monitoringProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation("IncidentCreator", fields: [createdBy], references: [id])

  assignedTeam Team? @relation(fields: [assignedTeamId], references: [id])

  monitoringProject MonitoringProject? @relation(fields: [monitoringProjectId], references: [id])

  tasks          Task[]
  alerts         Alert[]
  warRoom        WarRoom?
  timelineEvents TimelineEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([assignedTeamId])
  @@index([monitoringProjectId])
  @@map("incidents")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentPriority {
  P1
  P2
  P3
  P4
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentType {
  MANUAL
  AUTOMATED
}

model Task {
  id String @id @default(cuid())

  title       String
  description String?

  incidentId String
  assignedTo String? @db.Uuid

  type     TaskType     @default(MANUAL)
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignee User?    @relation("UserAssignedTasks", fields: [assignedTo], references: [id])

  files File[]

  @@index([incidentId])
  @@index([assignedTo])
  @@index([status])
  @@index([type])
  @@map("tasks")
}

enum TaskType {
  MANUAL
  AUTOMATIC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model MonitoringProject {
  id             String  @id @default(cuid())
  name           String
  description    String?
  organizationId String  @db.Uuid
  createdBy      String  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])

  alertRules        AlertRule[]
  integrations      Integration[]
  alerts            Alert[]
  alertRoutingRules AlertRoutingRule[]

  incidents Incident[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("monitoring_projects")
}

model Integration {
  id                  String @id @default(cuid())
  monitoringProjectId String
  organizationId      String @db.Uuid

  type   IntegrationType
  name   String
  config Json

  createdAt DateTime @default(now())

  monitoringProject MonitoringProject @relation(fields: [monitoringProjectId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  alerts Alert[]

  isActive Boolean @default(true)

  @@index([monitoringProjectId])
  @@index([organizationId])
  @@map("integrations")
}

model AlertRule {
  id                  String @id @default(cuid())
  monitoringProjectId String
  organizationId      String @db.Uuid

  name      String
  metric    String
  operator  AlertOperator
  threshold Float
  severity  IncidentSeverity
  priority  IncidentPriority

  autoCreateIncident Boolean @default(true)

  isPredefined Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitoringProject MonitoringProject @relation(fields: [monitoringProjectId], references: [id], onDelete: Cascade)

  alertRoutingRules AlertRoutingRule[]
  alerts            Alert[]

  @@index([monitoringProjectId])
  @@index([organizationId])
  @@index([monitoringProjectId, isActive])
  @@map("alert_rules")
}

model Alert {
  id                  String      @id @default(cuid())
  organizationId      String      @db.Uuid
  monitoringProjectId String
  integrationId       String?
  alertRuleId         String?
  createdBy           String?
  source              AlertSource

  title      String
  message    String?
  status     AlertStatus
  payload    Json
  incidentId String?
  createdAt  DateTime    @default(now())

  monitoringProject MonitoringProject @relation(fields: [monitoringProjectId], references: [id], onDelete: Cascade)
  integration       Integration?      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  alertRule         AlertRule?        @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  incident          Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([monitoringProjectId])
  @@index([integrationId])
  @@index([alertRuleId])
  @@index([incidentId])
  @@index([monitoringProjectId, status])
  @@map("alerts")
}

enum AlertSource {
  MANUAL
  AUTOMATIC
}

enum IntegrationType {
  PROMETHEUS
  GRAFANA
  WEBHOOK
}

enum AlertStatus {
  FIRING
  RESOLVED
}

enum AlertOperator {
  GT // >
  LT // <
  GTE // >=
  LTE // <=
  EQ // ==
}

model AlertRoutingRule {
  id                  String @id @default(cuid())
  organizationId      String @db.Uuid
  monitoringProjectId String
  alertRuleId         String
  teamId              String
  createdBy           String @db.Uuid

  name     String
  priority Int     @default(100)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitoringProject MonitoringProject @relation(fields: [monitoringProjectId], references: [id], onDelete: Cascade)
  alertRule         AlertRule         @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator           User              @relation("CreatedAlertRoutingRules", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([monitoringProjectId])
  @@index([alertRuleId])
  @@index([teamId])
  @@index([createdBy])
  @@index([monitoringProjectId, isActive, priority])
  @@map("alert_routing_rules")
}

model File {
  id         String @id @default(cuid())
  taskId     String
  uploadedBy String

  originalName String
  fileName     String
  mimeType     String
  size         Int

  storageUrl String
  publicId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model WarRoom {
  id String @id @default(cuid())

  incidentId String  @unique
  createdBy  String? @db.Uuid

  status WarRoomStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  incident     Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  creator      User?                @relation("WarRoomCreator", fields: [createdBy], references: [id])
  participants WarRoomParticipant[]
  messages     WarRoomMessage[]

  @@index([createdBy])
  @@index([status])
  @@map("war_rooms")
}

enum WarRoomStatus {
  ACTIVE
  CLOSED
}

model WarRoomParticipant {
  id String @id @default(cuid())

  warRoomId String
  userId    String @db.Uuid

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  warRoom WarRoom @relation(fields: [warRoomId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([warRoomId, userId])
  @@index([warRoomId])
  @@index([userId])
}

model WarRoomMessage {
  id        String   @id @default(uuid()) @db.Uuid
  warRoomId String
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warRoom WarRoom @relation(fields: [warRoomId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([warRoomId, createdAt])
  @@index([userId])
}

model TimelineEvent {
  id String @id @default(cuid())

  incidentId String
  actorId    String? @db.Uuid

  eventType TimelineEventType
  message   String
  metadata  Json?

  createdAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("TimelineEventActor", fields: [actorId], references: [id])

  @@index([incidentId])
  @@index([actorId])
  @@index([createdAt])
  @@map("timeline_events")
}

enum TimelineEventType {
  INCIDENT_CREATED
  INCIDENT_STATUS_CHANGED
  INCIDENT_UPDATED
  INCIDENT_TEAM_ASSIGNED

  TASK_CREATED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_UPDATED

  FILE_UPLOADED
  FILE_DELETED

  WAR_ROOM_CREATED
  WAR_ROOM_JOINED
  WAR_ROOM_LEFT
  WAR_ROOM_CLOSED

  INCIDENT_CREATED_FROM_ALERT
}

model AuditLog {
  id String @id @default(cuid())

  organizationId String  @db.Uuid
  actorId        String? @db.Uuid

  action     AuditAction
  entityType AuditEntityType
  entityId   String?

  description String
  metadata    Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT

  ORGANIZATION_UPDATED

  ROLE_CHANGED

  USER_CREATED
  USER_UPDATED

  USER_ADDED_TO_TEAM
  USER_REMOVED_FROM_TEAM
}

enum AuditEntityType {
  AUTH
  ORGANIZATION
  USER
  TEAM
  INCIDENT
  TASK
}

model Notification {
  id String @id @default(cuid())

  userId String @db.Uuid

  type    NotificationType
  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  INCIDENT
  TASK
}

model Plan {
  id String @id @default(cuid())

  name         PlanName @unique
  price        Float
  durationDays Int?
  maxProjects  Int?
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

enum PlanName {
  FREE
  PREMIUM
}

model Subscription {
  id             String @id @default(cuid())
  organizationId String @db.Uuid
  planId         String

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  reminder10DaysSentAt DateTime?
  reminder2DaysSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  payments Payment[]

  @@unique([organizationId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model Payment {
  id             String @id @default(cuid())
  organizationId String @db.Uuid
  subscriptionId String
  planId         String

  amount          Float
  currency        String        @default("INR")
  status          PaymentStatus
  transactionId   String?       @unique
  razorpayOrderId String        @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
